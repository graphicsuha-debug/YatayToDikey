{
  "name": "dikey-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Yatay yayın kayıtlarını dikey videoya dönüştüren yerel masaüstü stüdyosu.",
  "author": "Suha Yar",
  "homepage": "https://github.com/graphicsuha-debug/YatayToDikey",
  "repository": { "type": "git", "url": "https://github.com/graphicsuha-debug/YatayToDikey.git" },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "dist:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "pack:desktop": "electron-builder --config electron-builder.yml --win --x64 --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
